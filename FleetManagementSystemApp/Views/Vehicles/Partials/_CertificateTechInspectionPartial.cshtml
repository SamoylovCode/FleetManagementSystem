@model CertificateTechInspectionViewModel
@if (Model == null)
{
    <div class="alert alert-warning">CertificateTechInspection model is null — debug info: show nothing.</div>
    return;
}
<prefixed-field tag="input" type="hidden" asp-for="CertificateTechInspectionId" value="@Model.CertificateTechInspectionId" />
<prefixed-field tag="input" type="hidden" asp-for="VehicleId" value="@Model.VehicleId" />
<input type="hidden" name="CertificateTechInspection.RowVersion" value="@Convert.ToBase64String(Model.RowVersion ?? Array.Empty<byte>())" />

<h5>Диагностическая карта:</h5>
<div class="form-group mb-3">
    <prefixed-field tag="label" class="form-label" asp-for="CertificateTechInspectionNum">@Model.CertificateTechInspectionNum</prefixed-field>
    <prefixed-field tag="input" class="form-control" asp-for="CertificateTechInspectionNum" />
    <prefixed-field tag="span" asp-validation-for="CertificateTechInspectionNum" class="text-danger" />
</div>
<div class="form-group mb-3">
    <prefixed-field tag="label" class="form-label" asp-for="CertificateTechInspectionIssuedBy">@Model.CertificateTechInspectionIssuedBy</prefixed-field>
    <prefixed-field tag="input" class="form-control" asp-for="CertificateTechInspectionIssuedBy" />
    <prefixed-field tag="span" asp-validation-for="CertificateTechInspectionIssuedBy" class="text-danger" />
</div>
<div class="form-group mb-3">
    <div class="form-group mb-3">
        <label class="form-label" for="PeriodString">Срок действия диагностической карты</label>
        <div class="input-group">
            <input type="text" class="form-control" id="PeriodString" name="CertificateTechInspection.PeriodString" value="@Model.PeriodString" data-fieldtype="DateRange" />
            <div class="input-group-append">
                <span class="input-group-text">
                    <i class="bi bi-calendar"></i>
                </span>
            </div>
        </div>
        <span class="text-danger" data-valmsg-for="PeriodString" data-valmsg-replace="true"></span>
    </div>
</div>