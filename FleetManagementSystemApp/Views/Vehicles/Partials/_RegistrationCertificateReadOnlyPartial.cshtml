@model RegistrationCertificateViewModel

<div>
    <h5>Свидетельство о регистрации транспортного средства (СТС):</h5>
    <dl class="mb-3">
        <dt>@Html.DisplayNameFor(m => m.Number)</dt>
        <dd>@Model.Number</dd>

        <dt>@Html.DisplayNameFor(m => m.IssueDate)</dt>
        <dd>@Model.IssueDate</dd>
    </dl>
</div>