@model PassportViewModel

<prefixed-field tag="input" type="hidden" asp-for="PassportId" value="@Model.PassportId"/>
<prefixed-field tag="input" type="hidden" asp-for="VehicleId" value="@Model.VehicleId" />
<input type="hidden" name="Passport.RowVersion" value="@Convert.ToBase64String(Model.RowVersion ?? Array.Empty<byte>())" />

<h5>Паспорт транспортного средства (ПТС):</h5>
<div class="form-group mb-3">
    <prefixed-field tag="label" class="form-label" asp-for="Number">@Model.Number</prefixed-field>
    <prefixed-field tag="input" class="form-control" asp-for="Number" />
    <prefixed-field tag="span" asp-validation-for="Number" class="text-danger" />
</div>
<div class="form-group mb-3">
    <prefixed-field tag="label" class="form-label" asp-for="IssueDate">@Model.IssueDate</prefixed-field>
    <prefixed-field tag="input" type="date" class="form-control" asp-for="IssueDate" />
    <prefixed-field tag="span" asp-validation-for="IssueDate" class="text-danger" />
</div>