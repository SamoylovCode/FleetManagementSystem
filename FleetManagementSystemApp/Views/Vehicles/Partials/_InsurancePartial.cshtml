@model InsuranceViewModel

<prefixed-field tag="input" type="hidden" asp-for="InsuranceId" value="@Model.InsuranceId"/>
<prefixed-field tag="input" type="hidden" asp-for="VehicleId" value="@Model.VehicleId" />
<input type="hidden" name="Insurance.RowVersion" value="@Convert.ToBase64String(Model.RowVersion ?? Array.Empty<byte>())" />

<h5>Страховой полис:</h5>
<div class="form-group mb-3">
    <prefixed-field tag="label" class="form-label" asp-for="Number">@Model.Number</prefixed-field>
    <prefixed-field tag="input" class="form-control" asp-for="Number" />
    <prefixed-field tag="span" asp-validation-for="Number" class="text-danger" />
</div>
<div class="form-group mb-3">
    <prefixed-field tag="label" class="form-label" asp-for="IssuedBy">@Model.IssuedBy</prefixed-field>
    <prefixed-field tag="input" class="form-control" asp-for="IssuedBy" />
    <prefixed-field tag="span" asp-validation-for="IssuedBy" class="text-danger" />
</div>
<div class="form-group mb-3">
    <div class="form-group mb-3">
        <label class="form-label" for="PeriodString">Срок действия</label>
        <div class="input-group">
            <input type="text" class="form-control" id="PeriodString" name="Insurance.PeriodString" value="@Model.PeriodString" data-fieldtype="DateRange" />
            <div class="input-group-append">
                <span class="input-group-text">
                    <i class="bi bi-calendar"></i>
                </span>
            </div>
        </div>
        <span class="text-danger" data-valmsg-for="PeriodString" data-valmsg-replace="true"></span>
    </div>
</div>