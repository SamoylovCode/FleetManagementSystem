@model AlertViewModel

@{
    var alertAttribute = Model.IsSuccess ? "alert-success" : "alert-danger";
}

<div class="alert @alertAttribute d-flex align-items-center alert-dismissible fade show" id="autoCloseAlert" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i>
    <div>
        <strong>@Model.Message</strong>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>