@* _EmptyLayout.cshtml (used for pages without PartialPageModel) *@
@{
    var layoutName = Layout;
    <text><!-- Using layout: @layoutName --></text>
}

<!DOCTYPE html>
<html lang="ru">
<head>
    @await Html.PartialAsync("_MetaPartial")
    @await Html.PartialAsync("_CssPartial")
</head>
<body>
    @RenderBody()
</body>
</html>