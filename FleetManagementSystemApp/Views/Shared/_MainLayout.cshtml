@* _MainLayout.cshtml (used for internal pages where PartialPageModel is required) *@
@model object

<!DOCTYPE html>
<html lang="ru">
<head>
	@await Html.PartialAsync("_MetaPartial")
	@await Html.PartialAsync("_CssPartial")
</head>
<body>
	<h1>Main page</h1>
	<vc:sidebar/>
	<main role="main">
		<vc:modal title="Загрузка..."/>
		@RenderBody()
	</main>
	@await Html.PartialAsync("_ScriptsPartial")
</body>
</html>