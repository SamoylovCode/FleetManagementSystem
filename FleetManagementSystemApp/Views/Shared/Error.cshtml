@using FleetManagementSystemApp.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
@{
    Layout = "_EmptyLayout";
}
<div class="d-flex flex-column justify-content-center align-items-center min-vh-100 text-center p-3">
    <h1 class="text-danger">Ошибка.</h1>
    <h6 class="text-body">Произошла ошибка в результате Вашего запроса.</h6>
    <h5 class="text-body">@Model.Description</h5>
</div>