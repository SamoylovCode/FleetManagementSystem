<!DOCTYPE html>
<html lang="ru">
<head>
	@await Html.PartialAsync("_MetaPartial")
	@await Html.PartialAsync("_CssPartial")

</head>

<body class="main d-flex flex-column min-vh-100 m-0">
    <div class="container-fluid d-flex flex-column flex-fill p-4">
        <div class="row flex-fill gx-4 gy-4">
            <div class="col-12 col-md-6 d-flex align-items-stretch">
                <img src="~/images/default.jpg" class="img-fluid w-100 object-fit-cover" alt="" />
            </div>
            <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">
                <div class="container-fluid d-flex justify-content-center align-items-center flex-fill">
                    <div class="col-12 col-sm-10 col-md-8 col-lg-8 col-xl-7">
                        <div class="card p-4 p-md-3">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_ScriptsPartial")
</body>
</html>