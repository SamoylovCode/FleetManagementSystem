@model List<ApplicationUserDto>

@{
    Layout = "_MainLayout";
}

<h1>Сотрудники компании</h1>

<div class="d-inline-block mb-3">
	<button class="btn btn-prime mb-3"
		onclick="loadModal('Добавить сотрудника', '/Admin/AddUserPartial')">
		Зарегистрировать сотрудника
	</button>
</div>

<table>
	<thead>
		<tr>
            <th>#</th>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Email</th>
            <th>Роль</th>
		</tr>
	</thead>
	<tbody>
		@{
			int counter = 1;
			foreach(var u in Model)
			{
				<tr>
					<td>@(counter++)</td>
					<td>@u.LastName</td>
					<td>@u.FirstName</td>
					<td>@u.MiddleName</td>
					<td>@u.Email</td>
				</tr>
			}
		}
	</tbody>
</table>

<script>
	$.ajax({
		url: '/Admin/AddUserPartial',
		method: 'POST',
		success: function(response) {
			showSuccessToast('Данные сохранены!');
		},
		error: function(xhr) {
			showErrorToast('Ошибка: ' + xhr.responseText);
		}
	});
</script>