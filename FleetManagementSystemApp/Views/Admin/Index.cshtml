@model PartialPageModel

@{
    Layout = "_MainLayout";
}
<h5>Содержимое страницы Admin/Index</h5>
@await Html.PartialAsync(Model.PartialViewName, Model.ViewModel)

<script>
    $.ajax({
        url: '/api/save-data',
        method: 'POST',
        success: function(response) {
            showSuccessToast('Данные сохранены!');
        },
        error: function(xhr) {
            showErrorToast('Ошибка: ' + xhr.responseText);
        }
    });
</script>