@model ResetUserPasswordViewModel

@{
	ViewData["Title"] = "Забыли пароль?";
}

<h1>@ViewData["Title"]</h1>
<p>Введите Ваш email адрес, на который будет отправлен код для сброса пароля.</p>
<form asp-controller="Account" asp-action="ResetPassword" method="post">
	@Html.AntiForgeryToken();

	<div asp-validation-summary="All"></div>
	<label asp-for="Email"></label>
	<input name="Email" asp-for="Email" />
	<span asp-validation-for="Email" class="text-danger"></span>
	<br />
	<button type="submit">Отправить код</button>
</form>