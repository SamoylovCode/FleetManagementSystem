@model LoginViewModel

@{
	ViewData["Title"] = "Войти в учетную запись";
}

<h1>@ViewData["Title"]</h1>
<form asp-controller="Account" asp-action="Login" method="post">
	@Html.AntiForgeryToken()

	<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

	<label asp-for="Email"></label>
	<input name="Email" asp-for="Email" />
	<span asp-validation-for="Email" class="text-danger"></span>

	<label asp-for="Password"></label>
	<input name="Password" asp-for="Password" type="password" />
	<span asp-validation-for="Password" class="text-danger"></span>

	<input name="RememberMe" asp-for="RememberMe" type="checkbox" />
	<label asp-for="RememberMe">Запомнить меня</label>

	<a asp-controller="Account" asp-action="ResetPassword">Забыли пароль?</a>
	<br />
	<button type="submit" class="btn btn-primary">Войти</button>
</form>
<p>Нет учетной записи? </p>
<a asp-controller="Account" asp-action="Register">Зарегистрируйтесь</a>