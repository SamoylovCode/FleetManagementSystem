@model SetPassword

@{
	Layout = "_EmptyLayout";
	ViewData["Title"] = "Установите пароль";
}

<h1>@ViewData["Title"]</h1>
<form asp-controller="Account" asp-action="SetPassword" method="post">
	@Html.AntiForgeryToken()

	<input type="hidden" asp-for="UserId" />
	<input type="hidden" asp-for="Token" />

	<div asp-validation-summary="All"></div>
	<label asp-for="Password"></label>
	<input name="Password" asp-for="Password" type="password" />
	<span asp-validation-for="Password" class="text-danger"></span>

	<label asp-for="PasswordConfirm"></label>
	<input name="PasswordConfirm" asp-for="PasswordConfirm" type="password" />
	<span asp-validation-for="PasswordConfirm" class="text-danger"></span>

	<button type="submit" class="btn btn-primary">Сохранить</button>
</form>