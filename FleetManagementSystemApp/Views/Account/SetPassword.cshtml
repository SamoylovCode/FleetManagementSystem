@model SetPassword

@{
	Layout = "_EmptyLayout";
}

<div class="container-fluid d-flex flex-column flex-fill align-items-center justify-content-center">
    <div class="card p-4 p-md-3">
        <h1 class="text-center mb-4">Установите пароль</h1>
        <h5 class="text-secondary mb-4">Пожалуйста, установите пароль.</h5>
        <div class="mb-4">
            @Html.ValidationSummary(
                excludePropertyErrors: true,
                message: "Пожалуйста, исправьте ошибки: ",
                new { @class = "alert alert-danger" })
        </div>
        <form asp-controller="Account" asp-action="SetPassword" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" name="Password" asp-for="Password" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="PasswordConfirm"></label>
                <input class="form-control" name="PasswordConfirm" asp-for="PasswordConfirm" type="password" />
                <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-prime w-100 py-2 mb-3 mt-3">Сохранить</button>
        </form>
    </div>
</div>

