# FROM — команда, которая инициализирует новый этап сборки и устанавливает базовый образ для последующих инструкций
# AS <имя_сборки> — можно дать имя новому этапу сборки, например, build
# RUN <команда> - запуск команды в новом слое поверх текущего образа и фиксация результата
# COPY <директория_из> <директория_в>; Точка (.) в инструкции COPY означает, что копирование выполняется в текущий рабочий каталог образа. Конструкция «./.» (или «./.») указывает, что копирование происходит в указанную директорию внутри контейнера. Это происходит, когда нужно скопировать файлы и папки из текущей директории, где находится пользователь, в указанную директорию в контейнере. Если в начале пути к рабочей директории стоит «/», то путь будет абсолютным, а если «/» нет — относительным текущего. Пример: COPY ./mypasswd /root/ — копирует файл ./mypasswd в папку /root/ внутри контейнера. 

# --- ЭТАП СБОРКИ ---
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
# Установка рабочей директории контейнера (все команды будут выполняться относительно нее)
WORKDIR /source

# Копирование файла проекта и восстановление зависимостей
COPY FleetManagementSystemApp.csproj ./
RUN dotnet restore "FleetManagementSystemApp.csproj"

# Копирование production-файла конфигурации
COPY appsettings.Production.json ./

# Копирование всего кода из текущей папки
# . — это всё содержимое текущей директории на хосте (вне контейнера), откуда запускается сборка Docker-образа
# ./ — это целевая директория в контейнере, то есть текущая рабочая директория, которая установлена через WORKDIR /source
# TODO: для оптимизации сборки нужно копировать только то, что нужно до `dotnet publish`
COPY . /source/

WORKDIR /source

# Публикация приложения
# -c - (от "configuration") опция выбора типа сборки release, debug
# -o <path> - (output) путь внутри контейнера, куда будут помещены результаты публикации (скомпилированные DLL, исполняемые файлы, зависимости и т.д.)
RUN dotnet publish "FleetManagementSystemApp.csproj" -c Release -o /app/publish

# --- ЭТАП ЗАПУСКА (runtime) ---
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Копирование опубликованного приложения
# --from=<имя_предыдущего_этапа> <путь> — указывает, откуда копировать; build — это имя предыдущего этапа (stage) в многоэтапной сборке Docker (multi-stage build); /app/publish — путь в файловой системе образа build, откуда нужно взять файлы
COPY --from=build /app/publish ./

# Копирование файлов конфигурации
COPY --from=build /source/appsettings.Production.json ./

# Установка переменных окружения по умолчанию для продакшена
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Открытие порта 8080 для приложения
EXPOSE 8080

# Запуск приложения с явным указанием URL
ENTRYPOINT ["dotnet", "FleetManagementSystemApp.dll", "--urls", "http://0.0.0.0:8080"]